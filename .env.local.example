# ---------------------------------------------------------------------------
# O'Briens Solicitors — environment variables
# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for preview/production.
# ---------------------------------------------------------------------------

# --- Chatbot (Vercel AI SDK + Google) --------------------------------------
# Google AI Studio API key. Free tier: ~15 requests/min, ~1,000 requests/day,
# shared across the whole site. https://aistudio.google.com/apikey
# Required — without it /api/chat returns 503 and the widget degrades to the
# "reach us directly" panel.
GOOGLE_GENERATIVE_AI_API_KEY=

# Maximum assistant replies per calendar day, site-wide. Keeps the site inside
# Google's free daily quota. Optional — defaults to 600.
CHATBOT_DAILY_BUDGET=600

# --- Contact form (Resend) --------------------------------------------------
# https://resend.com/api-keys — required for the contact form to send.
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_EMAIL_TO=obriens@obriens-solicitors.com.au

# Optional. Must be a domain verified in Resend. Falls back to Resend's
# onboarding@resend.dev sandbox address when unset.
# CONTACT_EMAIL_FROM="O'Briens Solicitors <website@obriens-solicitors.com.au>"

# --- Bot protection (Cloudflare Turnstile) ---------------------------------
# https://dash.cloudflare.com → Turnstile. Both optional: when unset, the
# widget is not rendered and server-side verification is skipped, so local
# development works without Cloudflare credentials.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Rate limiting (Upstash Redis) -----------------------------------------
# https://console.upstash.com — used for the shared chatbot quota counters and
# the contact-form limit. Optional: an in-memory limiter is used when unset,
# which is fine locally but does NOT work across serverless instances. Set
# these in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
